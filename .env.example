# ── Webhook ───────────────────────────────────────────────────────────────────
# Secret key that TradingView includes in every alert payload for validation
WEBHOOK_SECRET=change-me-in-production

# ── Alpaca (Paper Trading) ────────────────────────────────────────────────────
# Get these from https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Trading Config ────────────────────────────────────────────────────────────
SYMBOL=GEV
ORDER_NOTIONAL=500.0   # Dollar amount per trade (fractional shares)
DRY_RUN=True           # True = log only, no real orders placed

# ── Notifications (optional) ──────────────────────────────────────────────────
# Create an incoming webhook at https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=
