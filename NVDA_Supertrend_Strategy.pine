// ============================================================
// NVDA Swing Strategy — Supertrend + 200 SMA + Chandelier + ADX
// Pine Script v5  |  Timeframe: Daily  |  Ticker: NVDA
//
// ENTRY:  Supertrend flips bullish  AND  close > EMA(200)  AND  ADX(14) > 25
// EXIT:   Supertrend flips bearish  OR   close drops below Chandelier trailing stop
// STOP:   Chandelier Exit (ATR 22, multiplier 4.0) — ratchets up, never down
// SIZE:   1% account risk per trade, position sized by distance to Chandelier stop
//
// HOW TO USE:
//   1. Open TradingView → Pine Script Editor → paste this entire file
//   2. Click "Add to chart" — switch chart to NVDA Daily
//   3. Open "Strategy Tester" tab below the chart
//   4. Click the gear ⚙ on the strategy panel to tweak inputs
//   5. Set date range: Jan 2020 → today for a full-cycle backtest
//
// WEBHOOK ALERT JSON (copy into TradingView alert message field):
//   {"ticker":"{{ticker}}","action":"{{strategy.order.action}}",
//    "sentiment":"{{strategy.market_position}}",
//    "quantity":"{{strategy.order.contracts}}","price":"{{close}}",
//    "time":"{{timenow}}","interval":"{{interval}}"}
// ============================================================

//@version=5
strategy(
     title            = "NVDA Swing: Supertrend + 200EMA + ADX + Chandelier",
     shorttitle       = "NVDA-Swing",
     overlay          = true,
     pyramiding       = 0,
     default_qty_type = strategy.fixed,   // overridden by ATR sizing below
     default_qty_value = 1,
     initial_capital  = 100000,
     commission_type  = strategy.commission.percent,
     commission_value = 0.05,             // 5 bps per leg — realistic for retail
     slippage         = 2                 // 2 ticks slippage per order
)

// ─── INPUTS ──────────────────────────────────────────────────────────────────

grp1 = "Supertrend"
st_atr_len   = input.int(10,  "ATR Length",   minval=1,  group=grp1)
st_factor    = input.float(3.5,"Factor",       minval=0.1, step=0.1, group=grp1)

grp2 = "Trend Filter"
ema_len      = input.int(200, "EMA Length (trend filter)", minval=10, group=grp2)

grp3 = "ADX Filter"
adx_len      = input.int(14,  "ADX Length",   minval=1,  group=grp3)
adx_min      = input.float(25.0, "Min ADX to trade", minval=5.0, step=0.5, group=grp3)

grp4 = "Chandelier Exit (trailing stop)"
ce_atr_len   = input.int(22,  "ATR Length",   minval=1,  group=grp4)
ce_mult      = input.float(4.0,"ATR Multiplier", minval=0.5, step=0.25, group=grp4)

grp5 = "Position Sizing"
risk_pct     = input.float(1.0, "Account Risk % per trade", minval=0.1, step=0.1, group=grp5)

grp6 = "Earnings Blackout (bars before earnings to avoid entry)"
earnings_blackout = input.int(2, "Bars to avoid before earnings", minval=0, maxval=10, group=grp6,
     tooltip="Manual: set earnings dates in the Earnings tab or use a calendar script. This input is informational only — no auto-detection in Pine.")

grp7 = "Backtest Date Range"
start_date   = input.time(timestamp("2020-01-01"), "From", group=grp7)
end_date     = input.time(timestamp("2025-12-31"), "To",   group=grp7)

// ─── INDICATOR CALCULATIONS ──────────────────────────────────────────────────

// 1. Supertrend
[supertrend, st_dir] = ta.supertrend(st_factor, st_atr_len)
// st_dir: -1 = bullish (green), +1 = bearish (red)
st_bullish = st_dir == -1
st_bearish = st_dir == 1
st_flip_long  = ta.crossunder(st_dir, 0)   // red → green flip
st_flip_short = ta.crossover(st_dir, 0)    // green → red flip

// 2. Trend filter — 200 EMA
ema200 = ta.ema(close, ema_len)
above_ema = close > ema200

// 3. ADX (manual calculation — more reliable than ta.dmi for Pine v5)
up   = ta.change(high)
down = -ta.change(low)
plus_dm  = na(up)   ? na : (up > down and up > 0   ? up   : 0)
minus_dm = na(down) ? na : (down > up and down > 0 ? down : 0)
true_range = ta.rma(ta.tr, adx_len)
plus_di  = fixnan(100 * ta.rma(plus_dm,  adx_len) / true_range)
minus_di = fixnan(100 * ta.rma(minus_dm, adx_len) / true_range)
dx       = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_val  = ta.rma(dx, adx_len)
strong_trend = adx_val >= adx_min

// 4. Chandelier Exit — long side trailing stop
ce_atr    = ta.atr(ce_atr_len)
// Chandelier stop = highest high in last N bars minus (ATR × multiplier)
// We track it as a ratcheting level — only moves up, never down
var float chandelier_stop = na
highest_high = ta.highest(high, ce_atr_len)
raw_chandelier = highest_high - ce_atr * ce_mult
// Ratchet: stop only rises (tightens) once in a trade
chandelier_stop := strategy.position_size > 0
     ? math.max(nz(chandelier_stop, raw_chandelier), raw_chandelier)
     : raw_chandelier
chandelier_hit = strategy.position_size > 0 and close < chandelier_stop

// ─── ENTRY & EXIT CONDITIONS ─────────────────────────────────────────────────

in_date_range = time >= start_date and time <= end_date

// Long entry: Supertrend flips bullish + above 200 EMA + strong ADX
long_entry = st_flip_long and above_ema and strong_trend and in_date_range

// Exit conditions (either is sufficient)
exit_supertrend  = st_flip_short and strategy.position_size > 0
exit_chandelier  = chandelier_hit

// ─── POSITION SIZING (1% account risk per trade) ─────────────────────────────
// Risk amount = equity × risk_pct / 100
// Stop distance = entry price − chandelier stop at entry
// Shares = risk_amount / stop_distance

var float entry_price_for_sizing = na
risk_amount   = strategy.equity * risk_pct / 100
stop_distance = close - chandelier_stop  // positive when entry > stop

// Guard against zero/negative stop distance
safe_distance = stop_distance > 0 ? stop_distance : ce_atr
qty = math.floor(risk_amount / safe_distance)
qty := math.max(qty, 1)  // at least 1 share

// ─── ORDERS ──────────────────────────────────────────────────────────────────

if long_entry
    strategy.entry("Long", strategy.long, qty=qty,
         comment="ST flip ↑ | ADX=" + str.tostring(math.round(adx_val, 1)))

if exit_supertrend
    strategy.close("Long", comment="ST flip ↓")

if exit_chandelier
    strategy.close("Long", comment="Chandelier stop hit @ " + str.tostring(math.round(chandelier_stop, 2)))

// ─── ALERTS (for webhook automation) ─────────────────────────────────────────

alertcondition(long_entry,      title="NVDA BUY  — Supertrend flip + EMA + ADX", message='{"ticker":"{{ticker}}","action":"buy","sentiment":"long","quantity":"{{strategy.order.contracts}}","price":"{{close}}","time":"{{timenow}}"}')
alertcondition(exit_supertrend, title="NVDA SELL — Supertrend flip bearish",      message='{"ticker":"{{ticker}}","action":"sell","sentiment":"flat","quantity":"{{strategy.order.contracts}}","price":"{{close}}","time":"{{timenow}}"}')
alertcondition(exit_chandelier, title="NVDA SELL — Chandelier stop hit",           message='{"ticker":"{{ticker}}","action":"sell","sentiment":"flat","quantity":"{{strategy.order.contracts}}","price":"{{close}}","time":"{{timenow}}"}')

// ─── VISUALS ─────────────────────────────────────────────────────────────────

// Supertrend line (recolored)
plot(supertrend,
     title   = "Supertrend",
     color   = st_bullish ? color.new(color.lime, 0) : color.new(color.red, 0),
     linewidth = 2,
     style   = plot.style_line)

// 200 EMA
plot(ema200,
     title     = "EMA 200",
     color     = color.new(color.orange, 20),
     linewidth = 1,
     style     = plot.style_line)

// Chandelier trailing stop (only visible while in a trade)
plot(strategy.position_size > 0 ? chandelier_stop : na,
     title   = "Chandelier Stop",
     color   = color.new(color.fuchsia, 0),
     linewidth = 2,
     style   = plot.style_circles)

// Entry / exit arrows
plotshape(long_entry,
     title    = "Long Entry",
     location = location.belowbar,
     style    = shape.triangleup,
     size     = size.normal,
     color    = color.new(color.lime, 0),
     text     = "BUY")

plotshape(exit_supertrend or exit_chandelier,
     title    = "Exit",
     location = location.abovebar,
     style    = shape.triangledown,
     size     = size.normal,
     color    = color.new(color.red, 0),
     text     = "SELL")

// ADX status label in upper-right (updates each bar)
var label adx_label = na
label.delete(adx_label[1])
adx_color = adx_val >= adx_min ? color.new(color.lime, 20) : color.new(color.gray, 40)
adx_label := label.new(
     bar_index, high * 1.01,
     "ADX: " + str.tostring(math.round(adx_val, 1)) + (adx_val >= adx_min ? " ✓" : " ✗"),
     xloc    = xloc.bar_index,
     yloc    = yloc.price,
     color   = adx_color,
     style   = label.style_label_lower_right,
     textcolor = color.white,
     size    = size.small)

// Background: shade grey when ADX below threshold (no-trade zone)
bgcolor(not strong_trend ? color.new(color.gray, 90) : na,
     title = "Low ADX — no-trade zone")

// ─── INFORMATION TABLE ───────────────────────────────────────────────────────

var table info = table.new(position.top_right, 2, 7,
     bgcolor = color.new(color.black, 70),
     border_width = 1,
     border_color = color.new(color.gray, 60))

if barstate.islast
    table.cell(info, 0, 0, "Parameter",       text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 0, "Value",            text_color=color.silver, text_size=size.small)

    table.cell(info, 0, 1, "Supertrend ATR",   text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 1, str.tostring(st_atr_len) + " × " + str.tostring(st_factor),
                                                text_color=color.lime,   text_size=size.small)

    table.cell(info, 0, 2, "EMA Filter",       text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 2, str.tostring(ema_len),
                                                text_color=color.orange, text_size=size.small)

    table.cell(info, 0, 3, "ADX Filter",       text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 3, "≥ " + str.tostring(adx_min),
                                                text_color=adx_val >= adx_min ? color.lime : color.red,
                                                text_size=size.small)

    table.cell(info, 0, 4, "Chandelier ATR",   text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 4, str.tostring(ce_atr_len) + " × " + str.tostring(ce_mult),
                                                text_color=color.fuchsia,text_size=size.small)

    table.cell(info, 0, 5, "Risk/Trade",       text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 5, str.tostring(risk_pct) + "% equity",
                                                text_color=color.aqua,   text_size=size.small)

    table.cell(info, 0, 6, "Position",         text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 6, strategy.position_size > 0 ? "LONG " + str.tostring(strategy.position_size) + " sh" : "FLAT",
                                                text_color=strategy.position_size > 0 ? color.lime : color.gray,
                                                text_size=size.small)

// ─── END OF STRATEGY ─────────────────────────────────────────────────────────
